{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoL Coach Overlay",
  "version": "0.1.0",
  "identifier": "dev.nyx.lolcoachoverlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    },
    "windows": [
      {
        "label": "overlay",
        "title": "LoL Coach Overlay",
        "width": 300,
        "height": 232,
        "minWidth": 40,
        "minHeight": 40,
        "maxWidth": 520,
        "maxHeight": 400,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": true,
        "url": "index.html"
      },
      {
        "label": "panel",
        "title": "LoL Coach · Painel",
        "width": 1400,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "skipTaskbar": false,
        "visible": false,
        "theme": "Dark",
        "url": "index.html"
      },
      {
        "label": "settings",
        "title": "LoL Coach · Configurações",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": true,
        "skipTaskbar": false,
        "visible": false,
        "theme": "Dark",
        "url": "index.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US", "pt-BR"]
      }
    }
  },
  "plugins": {}
}
